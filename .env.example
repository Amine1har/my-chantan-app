# ─── Supabase ────────────────────────────────────────────────────────
# Filled automatically when you connect a database via Chantan.
# For local dev or self-hosting, fill these from your Supabase dashboard:
#   Settings → API → Project URL  + Project API keys

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Optional: server-side (for edge functions / scripts) ────────────
# NEVER commit this — anyone with this key bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Third-party API keys (for edge functions) ───────────────────────
# Add anything your edge functions need to call:
# STRIPE_SECRET_KEY=
# OPENAI_API_KEY=
# RESEND_API_KEY=
